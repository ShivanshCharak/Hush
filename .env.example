# ==============================================================================
# Decider-Sec Environment Configuration
# ==============================================================================

# Environment mode: 'development' (dev) or 'production' (prod)
# Set to 'production' or 'prod' on Render/Cloud deployments.
ENV=development

# Explicit decider backend override: 'ollama', 'bedrock', or 'strands'
# - 'ollama'  : Local dev model (e.g. qwen3:1.7b)
# - 'strands' : AWS Strands Decider (ultra-fast 2B calibrated System-1 decider)
# - 'bedrock' : AWS Bedrock Foundation LLM (Claude 3.5 Sonnet / Haiku)
DECIDER_BACKEND=strands

# ------------------------------------------------------------------------------
# AWS Strands Decider Configuration
# ------------------------------------------------------------------------------
STRANDS_DECIDER_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/StrandsDeciders_triage-xxx
STRANDS_DECIDER_ENDPOINT=http://localhost:8001
STRANDS_DECIDER_MODEL=StrandsAgents/strands-decider-2B

# ------------------------------------------------------------------------------
# Dev Configuration (Ollama)
# ------------------------------------------------------------------------------
DECIDER_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
DECIDER_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------------
# Prod Configuration (AWS Bedrock)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
BEDROCK_DECIDER_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Or Claude 3.5 Sonnet: anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ------------------------------------------------------------------------------
# Database (Supabase PostgreSQL / DuckDB)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# Dashboard API & CORS
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
PORT=8000
